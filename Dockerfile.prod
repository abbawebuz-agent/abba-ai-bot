FROM python:3.11-slim

WORKDIR /app

# Deploy trigger: 2026-05-30 jazzmin-revert
# Системные зависимости — минимальный набор для Railway
# Playwright/Chrome paketlari olib tashlandi (browserlar o'rnatilmagan)
# Tizim paketlari + postgresql-client-18 (pg_dump, backup uchun — DB PostgreSQL 18).
# PGDG repo codename DINAMIK (trixie/bookworm) — aks holda libpq5 konflikti bo'ladi.
# Avval curl/gnupg, keyin PGDG repo qo'shib, libpq-dev + postgresql-client-18 ni
# BITTA apt-get bilan o'rnatamiz (versiyalar mos bo'lishi uchun).
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl gnupg ca-certificates \
    && install -d /usr/share/postgresql-common/pgdg \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
       -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] http://apt.postgresql.org/pub/repos/apt $(. /etc/os-release && echo $VERSION_CODENAME)-pgdg main" \
       > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update && apt-get install -y --no-install-recommends \
      libpq-dev gcc gettext postgresql-client-18 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Node.js 20 LTS (frontend build uchun)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Python dependencies (cache-friendly layer)
COPY requirements.txt requirements.txt
COPY requirements-prod.txt requirements-prod.txt
RUN pip install --no-cache-dir -r requirements-prod.txt

# Node.js dependencies (cache-friendly layer)
COPY frontend/package.json frontend/package.json
RUN cd frontend && npm install

# Копируем весь проект
COPY . .

# React/Vite build (panel frontend)
RUN cd frontend && npm run build

# Admin SPA: JSX → JS (esbuild, Babel runtime kerak emas)
RUN node scripts/build_admin_spa.js

# Directories for media & static
RUN mkdir -p /app/media /app/staticfiles

EXPOSE 8000

# Railway startCommand (railway.json) ni ishlatadi — bu default CMD
CMD ["sh", "-c", "export DJANGO_SETTINGS_MODULE=mona.settings.production && python manage.py migrate --noinput && python manage.py collectstatic --noinput --clear && (python manage.py createsuperuser --no-input 2>/dev/null || true) && (python manage.py seed_test_data 2>/dev/null || true) && (python manage.py set_webhook 2>/dev/null || true) && uvicorn mona.asgi:application --host 0.0.0.0 --port ${PORT:-8000} --workers 1"]
